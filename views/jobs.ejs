<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', {title: "Available Jobs"}) %>
  <link rel="stylesheet" href="styles/style.css">
  <link rel="stylesheet" href="styles/jobs.css">

  <link href="https://cdn.datatables.net/v/dt/dt-3.1.5/r-4.1.1/datatables.min.css" rel="stylesheet" integrity="sha384-yPuqMM26m3xoq6dPtFxk8qhOIgSBjcasCVJ2HjOU4vVdW5pxV24CgXItr3dUux1j" crossorigin="anonymous">
  <link rel="stylesheet" href="https://cdn.datatables.net/responsive/4.1.1/css/responsive.dataTables.min.css">

  <script src="https://code.jquery.com/jquery-3.7.1.js" defer></script>
  <script src="https://cdn.datatables.net/v/dt/dt-3.1.5/r-4.1.1/datatables.min.js" integrity="sha384-LvxskSzbs78iwBmZWqEZZjntG+4km6MrgzZFvHA7p13W/4RyigYEl2SNif1zhq3F" crossorigin="anonymous" defer></script>
  
  <script src="/scripts/jobs.js" defer></script>
</head>
<body>
  <h1>Available Jobs</h1>

  <% if (jobs.length === 0) { %>
    <p>No jobs are available right now.</p>
  <% } else { %>
    <table id="jobs-table">
      <thead>
        <tr>
          <th>Job Title</th>
          <th>Company</th>
          <th>Trade Area</th>
          <th>Location</th>
          <th>Hours</th>
          <th>Date Posted</th>
          <th>Expires</th>
          <th>Submitted</th>
        </tr>
      </thead>
      <tbody>
        <% jobs.forEach((job) => { %>
          <tr
            data-title="<%= job["job-title"] %>"
            data-company="<%= job["company-name"] %>"
            data-trade="<%= job["trade-area"] %>"
            data-location="<%= job["location"] %>"
            data-hours="<%= job["working-hours"] %>"
            data-posted="<%= job["post-date"] %>"
            data-expires="<%= job["expiration-date"] %>"
            data-url="<%= job["application-url"] %>"
            data-description="<%= job["description"] %>"
          >
            <td><%= job["job-title"] %></td>
            <td><%= job["company-name"] %></td>
            <td><%= job["trade-area"] %></td>
            <td><%= job["location"] %></td>
            <td><%= job["working-hours"] %></td>
            <td><%= job["post-date"] %></td>
            <td><%= job["expiration-date"] %></td>
            <td><%= job["timestamp"].toLocaleDateString("en-US") %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>


 

  <div id="job-modal" class="modal" hidden>
    <div class="modal-content">
      <button id="modal-close" type="button" aria-label="Close">&times;</button>
      <h2 id="modal-title"></h2>
      <p id="modal-details"></p>
      <p id="modal-description"></p>
      <div class="modal-footer">
        <a id="modal-apply" href="#" target="_blank" rel="noopener noreferrer">Apply Now</a>
      </div>
    </div>
  </div>

   <!-- For responsive table  -->
  <script src="https://cdn.datatables.net/responsive/4.1.1/js/dataTables.responsive.min.js"></script>

</body>
</html>