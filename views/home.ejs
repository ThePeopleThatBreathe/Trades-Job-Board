<!DOCTYPE html>
<html lang="en">

<head>
  <%- include('partials/head', {title: "Trades Job Board"}) %>
  <%- include('partials/jQuery') %>
  <%- include('partials/datatables') %>

  <link rel="stylesheet" href="/styles/home.css">
  <script src="/scripts/home.js" defer></script>
</head>

<body>
  <header>
    <img src="/images/GRC_Logo_White.png" alt="GRC Logo">
    <div id="header-txt">
      <h1>Trades Job Board</h1>
    </div>
  </header>

  <nav id="main-nav">
    <a class="button" href="https://www.greenriver.edu/students/academics/areas-of-interest/program-maps/trades-industrial-tech-aviation-natural-resources/index.html" target="_blank">Learn more about the trades at Green River</a>
    <button class="button" id="login-btn" type="button">Login</button>
    <a class="button" id="add-job-link" href="/add-job" hidden>Add Jobs</a>
    <a class="button" id="saved-jobs-link" href="/saved-jobs" hidden>View Saved Jobs</a>
  </nav>

  <div id="main">
    <% if (jobs.length === 0) { %>
    <p>No jobs are available right now.</p>
    <% } else { %>
    <table id="jobs-table">
      <thead>
        <tr>
          <th>Job Title</th>
          <th>Company</th>
          <th>Trade Area</th>
          <th>Location</th>
          <th>Internship</th>
          <th>Hours</th>
          <th>Date Posted</th>
          <th>Expires</th>
        </tr>
      </thead>
      <tbody>
        <% jobs.forEach((job) => { %>
        <tr data-title="<%= job["job_title"] %>" data-company="<%= job["company_name"] %>" data-trade="<%= job["trade_area"] %>" data-location="<%= job["location"] %>" data-internship="<%= job["internship"] ? "Yes" : "No" %>" data-hours="<%= job["working_hours"] %>" data-posted="<%= job["post_date"] %>" data-expires="<%= job["expiration_date"] %>" data-url="<%= job["application_url"] %>" data-description="<%= job["description"] %>">
          <td><%= job["job_title"] %></td>
          <td><%= job["company_name"] %></td>
          <td><%= job["trade_area"] %></td>
          <td><%= job["location"] %></td>
          <td><%= job["internship"] ? "Yes" : "No" %></td>
          <td><%= job["working_hours"].toLocaleString() %></td>
          <td><%= job["post_date"].toLocaleDateString() %></td>
          <td><%= job["expiration_date"].toLocaleDateString() %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
    <% } %>



    <div id="job-modal" class="modal" role="dialog" aria-modal="true" aria-labelledby="modal-title" hidden>
      <div class="modal-content">
        <button id="modal-close" type="button" aria-label="Close">&times;</button>
        <h2 id="modal-title"></h2>

        <dl id="modal-details">
          <dt>Company</dt>
          <dd id="modal-company"></dd>
          <dt>Trade Area</dt>
          <dd id="modal-trade"></dd>
          <dt>Location</dt>
          <dd id="modal-location"></dd>
          <dt>Hours</dt>
          <dd id="modal-hours"></dd>
          <dt>Internship</dt>
          <dd id="modal-internship"></dd>
          <dt>Posted</dt>
          <dd id="modal-posted"></dd>
          <dt>Expires</dt>
          <dd id="modal-expires"></dd>
        </dl>

        <p id="modal-description"></p>

        <div class="modal-footer">
          <a id="modal-apply" href="#" target="_blank" rel="noopener noreferrer">Apply Now</a>
        </div>
      </div>
    </div>

    <div id="login-modal" class="modal" hidden>
      <div class="modal-content">
        <button id="login-close" type="button" aria-label="Close">&times;</button>
        <h2>Login</h2>
        <form id="login-form">
          <label for="username">Username</label>
          <input id="username" type="text">

          <label for="password">Password</label>
          <input id="password" type="password">

          <button class="button" type="submit">Log in</button>
          <p id="login-error" hidden>Check username or password.</p>
        </form>
      </div>
    </div>

  </div>

</body>

</html>